# ---------------------------------------------------------------------------
# VISTA environment configuration – copy to .env and change the values.
# Never commit a real .env file. All values below are local-development examples.
# ---------------------------------------------------------------------------

# PostgreSQL connection (SQLAlchemy URL). Render/Supabase "postgres://" URLs are accepted too.
DATABASE_URL=postgresql+psycopg://vista:change-me@localhost:5432/vista

# Secret used to sign login tokens (JWT). REQUIRED in production – use 32+ random characters,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=120

# development | production  (production enables HSTS and refuses to start without JWT_SECRET)
ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call the API (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Where uploaded files (vault, notes, delivery photos) are stored and the size limit
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# Brute-force protection: lock an account for N minutes after M failed logins
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Delivery handover OTP rules
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# How often (seconds) the server checks for complaints to escalate. 0 disables the background check.
ESCALATION_CHECK_SECONDS=300

# Optional: path of the built frontend served by the API (defaults to ../frontend/dist)
FRONTEND_DIST=

# Database connection pool per server worker. Keep workers x (POOL + OVERFLOW) below PostgreSQL max_connections.
DB_POOL_SIZE=35
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Frontend only (build time): API base URL when the frontend is hosted separately, e.g. on Vercel
VITE_API_URL=
